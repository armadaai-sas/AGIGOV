// Core ledger — PostgreSQL (fuente de verdad transaccional)
generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/core"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum PilotTenantStatus {
  provisioning
  active
  suspended
  closed
}

enum PilotOnboardingStatus {
  pending
  registered
  baseline_pending
  baseline_ratified
  ingest_ready
}

enum InstitutionUserStatus {
  active
  suspended
}

model PilotTenant {
  id                String                 @id @default(uuid())
  slug              String                 @unique
  ministryCode      String
  budgetCode        String
  displayName       String
  programName       String
  territoryCode     String                 @default("VEN_VIAL_PILOT_01")
  fiscalYear        Int                    @default(2026)
  quarter           Int                    @default(2)
  status            PilotTenantStatus      @default(provisioning)
  onboardingStatus  PilotOnboardingStatus  @default(pending)
  ingestTokenHash   String
  budgetLinePilotId String?
  baselineActaProcessId String?
  institutionSigners Json?
  baselineSignatures Json?
  multisigThreshold Int                    @default(3)
  originNodeId      String
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt

  @@unique([ministryCode, budgetCode])
  @@index([status])
  @@index([onboardingStatus])
  @@index([ministryCode])
}

model InstitutionUser {
  id              String                @id @default(uuid())
  email           String                @unique
  institutionName String
  entityType      String
  officialCode    String?
  contactName     String?
  contactRole     String?
  passwordSalt    String
  passwordHash    String
  status          InstitutionUserStatus @default(active)
  magicLinkHash   String?
  magicLinkExpiry DateTime?
  lastLoginAt     DateTime?
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt

  sessions InstitutionSession[]

  @@index([status])
}

model InstitutionSession {
  id         String   @id @default(uuid())
  userId     String
  user       InstitutionUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash  String   @unique
  expiresAt  DateTime
  revokedAt  DateTime?
  createdAt  DateTime @default(now())
  lastSeenAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

enum ProcessStatus {
  received
  validated
  decided
  committed
  published
  frozen
}

enum EscrowStatus {
  PENDING
  LOCKED
  RELEASED
  FROZEN
}

enum EgsPilotStatus {
  draft
  active
  closed
  frozen
}

enum QuarterCloseStatus {
  DRAFT
  BASELINE_LOCKED
  COLLECTING
  PENDING_VALIDATION
  DELTA_CALCULATED
  SPLIT_APPROVED
  PUBLISHED
  FROZEN
}

enum LedgerEntryType {
  VOTE
  ESCROW
  ACTA
  TRUST_EDGE
  PROCESS
}

model TerritorialNode {
  id           String    @id @default(uuid())
  code         String    @unique
  name         String
  originNodeId String    @unique @default(uuid())
  version      Int       @default(1)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  citizens  Citizen[]
  votes     Vote[]
  escrows   Escrow[]
  actas     Acta[]
  trustNodes TrustNode[]

  @@index([updatedAt])
}

model Citizen {
  id           String    @id @default(uuid())
  did          String    @unique
  displayName  String?
  territoryId  String
  territory    TerritorialNode @relation(fields: [territoryId], references: [id])
  originNodeId String
  version      Int       @default(1)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  votes      Vote[]
  trustNode  TrustNode?

  @@index([territoryId])
  @@index([updatedAt])
  @@index([originNodeId])
}

model Vote {
  id           String   @id @default(uuid())
  payloadHash  String   @unique
  citizenDid   String
  citizen      Citizen  @relation(fields: [citizenDid], references: [did])
  territoryId  String
  territory    TerritorialNode @relation(fields: [territoryId], references: [id])
  processId    String
  signature    String
  payload      Json
  originNodeId String
  committedAt  DateTime @default(now())

  @@index([territoryId])
  @@index([processId])
  @@index([citizenDid])
}

model Escrow {
  id           String       @id @default(uuid())
  processId    String       @unique
  territoryId  String?
  territory    TerritorialNode? @relation(fields: [territoryId], references: [id])
  budgetLinePilotId String?
  budgetLinePilot   BudgetLinePilot? @relation(fields: [budgetLinePilotId], references: [id])
  amount       Decimal      @db.Decimal(18, 4)
  currency     String       @default("VES")
  status       EscrowStatus @default(PENDING)
  threshold    Int
  signers      Json
  originNodeId String
  version      Int          @default(1)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  quarterCloseReleases QuarterCloseRelease[]

  @@index([status])
  @@index([updatedAt])
  @@index([originNodeId])
  @@index([territoryId])
  @@index([budgetLinePilotId])
}

/// Partida presupuestaria incluida en piloto EGS (infraestructura vial).
model BudgetLinePilot {
  id           String         @id @default(uuid())
  ministryCode String
  budgetCode   String
  programName  String
  currency     String         @default("VES")
  pilotStatus  EgsPilotStatus @default(draft)
  originNodeId String
  version      Int            @default(1)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  escrows       Escrow[]
  baselineActs  BaselineAct[]
  quarterCloses QuarterClose[]

  @@unique([ministryCode, budgetCode])
  @@index([pilotStatus])
  @@index([updatedAt])
}

/// Acta baseline 24m — fuente de verdad para baseline trimestral.
model BaselineAct {
  id                   String          @id @default(uuid())
  budgetLinePilotId    String
  budgetLinePilot      BudgetLinePilot @relation(fields: [budgetLinePilotId], references: [id])
  fiscalYear           Int
  historicalMonths     Int             @default(24)
  annualAmountBaseline Decimal         @db.Decimal(18, 4)
  seasonalFactorQ1     Decimal         @default(1) @db.Decimal(8, 4)
  seasonalFactorQ2     Decimal         @default(1) @db.Decimal(8, 4)
  seasonalFactorQ3     Decimal         @default(1) @db.Decimal(8, 4)
  seasonalFactorQ4     Decimal         @default(1) @db.Decimal(8, 4)
  contentHash          String          @unique
  actaProcessId        String          @unique
  signedAt             DateTime?
  signers              Json
  originNodeId         String
  version              Int             @default(1)
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt

  @@index([budgetLinePilotId])
  @@index([fiscalYear])
}

/// Cierre trimestral EGS — cálculo automático Δ y reparto 70/20/10.
model QuarterClose {
  id                   String             @id @default(uuid())
  budgetLinePilotId    String
  budgetLinePilot      BudgetLinePilot    @relation(fields: [budgetLinePilotId], references: [id])
  fiscalYear           Int
  quarter              Int
  status               QuarterCloseStatus @default(DRAFT)
  baselineTrimestral   Decimal            @db.Decimal(18, 4)
  gastosVerificados    Decimal            @default(0) @db.Decimal(18, 4)
  ajustesFuerzaMayor   Decimal            @default(0) @db.Decimal(18, 4)
  calculoAhorroFinal   Decimal            @default(0) @db.Decimal(18, 4)
  reinversionAmount    Decimal            @default(0) @db.Decimal(18, 4)
  meritPoolAmount      Decimal            @default(0) @db.Decimal(18, 4)
  agigovFeeAmount      Decimal            @default(0) @db.Decimal(18, 4)
  currency             String             @default("VES")
  treasuryRef          String?
  ledgerProcessId      String?            @unique
  contentHash          String?            @unique
  signedAt             DateTime?
  signers              Json?
  originNodeId         String
  version              Int                @default(1)
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  verifiedReleases         QuarterCloseRelease[]
  forceMajeureAdjustments  ForceMajeureAdjustment[]

  @@unique([budgetLinePilotId, fiscalYear, quarter])
  @@index([status])
  @@index([fiscalYear, quarter])
  @@index([updatedAt])
}

/// Liberación Smart Escrow contabilizada en un trimestre (1 fila por hito).
model QuarterCloseRelease {
  id             String       @id @default(uuid())
  quarterCloseId String
  quarterClose   QuarterClose @relation(fields: [quarterCloseId], references: [id])
  escrowId       String
  escrow         Escrow       @relation(fields: [escrowId], references: [id])
  milestoneIndex Int
  amount         Decimal      @db.Decimal(18, 4)
  evidenceRef    String
  verifiedAt     DateTime
  originNodeId   String
  createdAt      DateTime     @default(now())

  @@unique([quarterCloseId, escrowId, milestoneIndex])
  @@index([quarterCloseId])
  @@index([escrowId])
}

/// Ajuste fuerza mayor — tope 5% baseline trimestral (validación en aplicación).
model ForceMajeureAdjustment {
  id             String       @id @default(uuid())
  quarterCloseId String
  quarterClose   QuarterClose @relation(fields: [quarterCloseId], references: [id])
  amount         Decimal      @db.Decimal(18, 4)
  reason         String
  actaProcessId  String
  approvedAt     DateTime
  originNodeId   String
  createdAt      DateTime     @default(now())

  @@index([quarterCloseId])
}

model Acta {
  id           String        @id @default(uuid())
  processId    String        @unique
  territoryId  String?
  territory    TerritorialNode? @relation(fields: [territoryId], references: [id])
  title        String
  contentHash  String        @unique
  sovereignDid String
  status       ProcessStatus @default(received)
  originNodeId String
  version      Int           @default(1)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([status])
  @@index([updatedAt])
  @@index([territoryId])
}

model TrustNode {
  id           String   @id @default(uuid())
  citizenDid   String   @unique
  citizen      Citizen  @relation(fields: [citizenDid], references: [did])
  territoryId  String
  territory    TerritorialNode @relation(fields: [territoryId], references: [id])
  score        Float    @default(0)
  originNodeId String
  version      Int      @default(1)
  updatedAt    DateTime @updatedAt

  edgesFrom TrustEdge[] @relation("TrustFrom")
  edgesTo   TrustEdge[] @relation("TrustTo")

  @@index([territoryId])
  @@index([updatedAt])
}

model TrustEdge {
  id           String    @id @default(uuid())
  fromNodeId   String
  fromNode     TrustNode @relation("TrustFrom", fields: [fromNodeId], references: [id])
  toNodeId     String
  toNode       TrustNode @relation("TrustTo", fields: [toNodeId], references: [id])
  weight       Float
  evidenceRef  String
  originNodeId String
  version      Int       @default(1)
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  @@unique([fromNodeId, toNodeId])
  @@index([updatedAt])
  @@index([originNodeId])
}

model LedgerEntry {
  id          String          @id @default(uuid())
  entryType   LedgerEntryType
  entityId    String
  entityHash  String          @unique
  processId   String
  agentId     String
  evidenceRef String
  committedAt DateTime        @default(now())

  @@index([processId])
  @@index([entryType])
  @@index([committedAt])
}

model ProcessCheckpoint {
  id             String        @id @default(uuid())
  processId      String        @unique
  status         ProcessStatus @default(received)
  agentId        String
  evidenceBundle Json
  originNodeId   String
  version        Int           @default(1)
  updatedAt      DateTime      @updatedAt

  @@index([status])
  @@index([updatedAt])
  @@index([originNodeId])
}

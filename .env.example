# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# --- Bus soberano IAP (MQTT sobre WireGuard) ---
# Broker accesible solo dentro de la VPN WireGuard (ej. mqtt://10.8.0.1:1883)
MQTT_URL="mqtt://10.8.0.1:1883"
MQTT_CLIENT_ID="armada-node-01"
BUS_SHARD="core"
BUS_SUBSCRIBE_AUDIT="false"
BUS_FLUSH_INTERVAL_MS="15000"
PANIC_MODE="false"

# Nodo local — generar con: npm run bus:seed
NODE_DID="did:armada:core:centinela"
NODE_ED25519_SECRET_KEY_B64=""
NODE_ED25519_PUBLIC_KEY_B64=""
NODE_X25519_SECRET_KEY_B64=""
NODE_X25519_PUBLIC_KEY_B64=""

DID_REGISTRY_PATH="data/did-registry.json"
OUTBOX_DB_PATH="data/iap-outbox.db"

# --- Ledger Fase 2 (Prisma) ---
DATABASE_URL="postgresql://armada:armada@127.0.0.1:5432/armada_core?schema=public"
EDGE_DATABASE_URL="file:../data/edge.db"
ORIGIN_NODE_ID="node-local-01"
AGENT_ROLE="centinela"

# --- PWA ciudadana (Fase 4) ---
PUBLIC_API_PORT="3001"
# Vacío en dev (proxy Vite /api → :3001). En prod, URL absoluta si API está en otro host.
VITE_PUBLIC_API_URL=""

# --- Nodo territorial edge (Fase 5) ---
TERRITORY_CODE="MAR_NORTH_01"
NODE_TIER="peripheral"
EDGE_SYNC_INTERVAL_MS="30000"
EDGE_SYNC_BATCH_SIZE="50"
EDGE_MAX_SYNC_ATTEMPTS="12"
CORE_HEALTH_URL="http://127.0.0.1:3001/api/public/health"
LORAWAN_DEMO_TOPIC="lorawan/demo/up"

# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# --- Bus soberano IAP (MQTT sobre WireGuard) ---
# Broker accesible solo dentro de la VPN WireGuard (ej. mqtt://10.8.0.1:1883)
MQTT_URL="mqtt://10.8.0.1:1883"
MQTT_CLIENT_ID="agigov-node-01"
BUS_SHARD="core"
BUS_SUBSCRIBE_AUDIT="false"
BUS_FLUSH_INTERVAL_MS="15000"
PANIC_MODE="false"

# Nodo local — generar con: npm run bus:seed
NODE_DID="did:agigov:core:centinela"
NODE_ED25519_SECRET_KEY_B64=""
NODE_ED25519_PUBLIC_KEY_B64=""
NODE_X25519_SECRET_KEY_B64=""
NODE_X25519_PUBLIC_KEY_B64=""

DID_REGISTRY_PATH="data/did-registry.json"
OUTBOX_DB_PATH="data/iap-outbox.db"

# --- Ledger Fase 2 (Prisma) ---
DATABASE_URL="postgresql://agigov:agigov@127.0.0.1:5432/agigov_core?schema=public"
EDGE_DATABASE_URL="file:../data/edge.db"
ORIGIN_NODE_ID="node-local-01"
AGENT_ROLE="centinela"

# --- PWA ciudadana (Fase 4) ---
PUBLIC_API_PORT="3001"
# Vacío en dev (proxy Vite /api → :3001). En prod, URL absoluta si API está en otro host.
VITE_PUBLIC_API_URL=""
# Destino del proxy de desarrollo para /api (ver vite.config.ts). En local apunta a
# tu API (npm run api:public → http://localhost:3001). Si se omite, usa por defecto
# el servidor demo público; en un repo público conviene fijarlo a tu propio backend.
VITE_API_PROXY="http://localhost:3001"
# Debug local para flujo magic-link institucional (no habilitar en prod).
AGIGOV_MAGIC_LINK_DEBUG="1"
# Clave opcional para monitoreo ops machine-to-machine (header X-Ops-Key).
AGIGOV_OPS_API_KEY=""
# URL pública de la PWA (links en correos institucionales).
AGIGOV_APP_URL="http://localhost:3000"
# Correo: outbox | resend
# Free sin costo compañía: usar outbox. Resend solo con AGIGOV_EMAIL_BYO=1 (key del cliente).
AGIGOV_EMAIL_MODE="outbox"
AGIGOV_EMAIL_OUTBOX_PATH="data/email-outbox.jsonl"
AGIGOV_EMAIL_LOG="1"
# Resend (saas+ o Free BYO). Nunca commits la key.
# AGIGOV_EMAIL_MODE="resend"
# AGIGOV_RESEND_API_KEY="re_xxxxxxxx"
# AGIGOV_EMAIL_BYO="1"
AGIGOV_EMAIL_FROM="AGIGOV <noreply@bold-street.com>"
AGIGOV_EMAIL_REPLY_TO="info@armadaai.co"
# Allowlist: off | warn | enforce
AGIGOV_EMAIL_ALLOWLIST_MODE="warn"
# AGIGOV_EMAIL_ALLOWLIST="bold-street.com,armadaai.co,gob.ve,gov.co"

# --- Cobro P0 (Free sin costo compañía) ---
# free | saas | sovereign — default free
AGIGOV_PLAN="free"
# byo = cliente hospeda (obligatorio en free) | agigov = hosting compañía (solo saas+)
AGIGOV_HOSTING="byo"
# Free + Resend solo si la key es del cliente (si no, runtime coacciona a outbox):
# AGIGOV_EMAIL_BYO="1"
# Add-on EGS (10% Δ): 1 = on · 0 = off
AGIGOV_EGS_ADDON="1"
# IA add-on (off en free)
AGIGOV_AI_ENABLED="0"
# AGIGOV_PQC_MODE=inventory
# Pasarela VES — HMAC obligatorio si NODE_ENV=production
# AGIGOV_PAYMENT_WEBHOOK_SECRET=""

# --- Nodo territorial edge (Fase 5) ---
TERRITORY_CODE="MAR_NORTH_01"
NODE_TIER="peripheral"
EDGE_SYNC_INTERVAL_MS="30000"
EDGE_SYNC_BATCH_SIZE="50"
EDGE_MAX_SYNC_ATTEMPTS="12"
CORE_HEALTH_URL="http://127.0.0.1:3001/api/public/health"
OPS_HEALTH_URL="http://127.0.0.1:3001/api/ops/health"
SANDBOX_API_PORT="3002"
SBX_HEALTH_URL="http://127.0.0.1:3002/api/public/health"
AGIGOV_PEER_HEALTH_URL="http://127.0.0.1:3002/api/public/health"
AGIGOV_ISO="VEN"
AGIGOV_JURISDICTION="AGIGOV-VEN"
AGIGOV_CURRENCY="VES"
AGIGOV_LOCALE="es-VE"
AGIGOV_TIMEZONE="America/Caracas"
# Colombia (nodo piloto): AGIGOV_ISO=COL AGIGOV_CURRENCY=COP AGIGOV_LOCALE=es-CO AGIGOV_TIMEZONE=America/Bogota
# Luego: npm run pilot:provision  → tenant mintrans-trust-pilot en COP
# USA (demo): AGIGOV_ISO=USA AGIGOV_CURRENCY=USD AGIGOV_LOCALE=en-US AGIGOV_TIMEZONE=America/New_York
LORAWAN_DEMO_TOPIC="lorawan/demo/up"
